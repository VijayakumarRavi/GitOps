---
version: v1alpha1
machine:
  ca:
    crt: op://automation/talos-robin/MACHINE_CA_CRT
    {% if ENV.IS_CONTROLLER %}
    key: op://automation/talos-robin/MACHINE_CA_KEY
    {% endif %}
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: false
      resolveMemberNames: true
    kubePrism:
      enabled: true
      port: 7445
    {% if ENV.IS_CONTROLLER %}
    kubernetesTalosAPIAccess:
      allowedKubernetesNamespaces:
        - actions-runner-system
        - system-upgrade
      allowedRoles:
        - os:admin
      enabled: true
    {% endif %}
    rbac: true
    stableHostname: true
  files:
    - op: create
      path: /etc/cri/conf.d/20-customization.part
      content: |
        [plugins]
          [plugins."io.containerd.grpc.v1.cri"]
            enable_unprivileged_ports = true
            enable_unprivileged_icmp = true
        [plugins."io.containerd.grpc.v1.cri".containerd]
          discard_unpacked_layers = false
        [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
          discard_unpacked_layers = false
    # haproxy config: bridges public IPv4 → IPv6 Envoy VIP
    # NODE_IPV4 and NODE_IPV6 are resolved from 1Password at apply time.
    - op: create
      path: /var/etc/ipv4-proxy/haproxy.cfg
      permissions: 0o644
      content: |
        global
          daemon
        defaults
          timeout connect 5s
          timeout client  30s
          timeout server  30s
        frontend https
          mode tcp
          bind op://automation/talos-robin/NODE_IPV4:443
          default_backend envoy-https
        backend envoy-https
          mode tcp
          server envoy [op://automation/talos-robin/NODE_IPV6]:443 send-proxy-v2 check
        frontend http
          mode tcp
          bind op://automation/talos-robin/NODE_IPV4:80
          default_backend envoy-http
        backend envoy-http
          mode tcp
          server envoy [op://automation/talos-robin/NODE_IPV6]:80 send-proxy-v2 check
        frontend ldap
          mode tcp
          bind op://automation/talos-robin/NODE_IPV4:32621
          default_backend lldap-direct
        backend lldap-direct
          mode tcp
          server lldap [op://automation/talos-robin/NODE_IPV6]:32621 check
    - op: overwrite
      path: /etc/nfsmount.conf
      permissions: 0o644
      content: |
        [ NFSMount_Global_Options ]
        nfsvers=4.2
        hard=True
        nconnect=16
        noatime=True
  install:
    disk: /dev/vda
    image: factory.talos.dev/installer/00d6a41635167ecec3aaaf416c2fdebb5dde36a9216a5257f6a9d71da7367ee8:v1.13.4
    wipe: false
  kernel:
    modules:
      - name: dm_thin_pool
  systemDiskEncryption:
    state:
      provider: luks2
      keys:
        - slot: 0
          nodeID: {}
    ephemeral:
      provider: luks2
      keys:
        - slot: 0
          nodeID: {}

  kubelet:
    extraMounts:
      - destination: /var/etc/ipv4-proxy
        type: bind
        source: /var/etc/ipv4-proxy
        options:
          - bind
          - rshared
          - rw
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraConfig:
      featureGates:
        ImageVolume: true
        ResourceHealthStatus: true
      serializeImagePulls: false
    image: ghcr.io/siderolabs/kubelet:v1.36.1
    nodeIP:
      validSubnets:
        - op://automation/talos-robin/NODE_IPV6_SUBNET
  network:
    disableSearchDomain: true
  nodeLabels:
    topology.kubernetes.io/region: main
  sysctls:
    fs.inotify.max_user_instances: "8192"
    fs.inotify.max_user_watches: "1048576"
    net.core.default_qdisc: fq
    net.core.rmem_max: "67108864"
    net.core.wmem_max: "67108864"
    net.ipv4.neigh.default.gc_thresh1: "4096"
    net.ipv4.neigh.default.gc_thresh2: "8192"
    net.ipv4.neigh.default.gc_thresh3: "16384"
    net.ipv4.tcp_congestion_control: bbr
    net.ipv4.tcp_fastopen: "3"
    net.ipv4.tcp_mtu_probing: "1"
    net.ipv4.tcp_rmem: 4096 87380 33554432
    net.ipv4.tcp_window_scaling: "1"
    net.ipv4.tcp_wmem: 4096 65536 33554432
    net.ipv6.conf.all.forwarding: "1"
    net.ipv6.conf.default.forwarding: "1"
    sunrpc.tcp_max_slot_table_entries: "128"
    sunrpc.tcp_slot_table_entries: "128"
    user.max_user_namespaces: "11255"
  pods:
    # Static pod: haproxy bridges IPv4 → IPv6 Envoy VIP (outside Kubernetes scheduling)
    - apiVersion: v1
      kind: Pod
      metadata:
        name: ipv4-proxy
        namespace: kube-system
      spec:
        containers:
          - image: mirror.gcr.io/haproxy:3.2-alpine
            name: haproxy
            securityContext:
              runAsUser: 0
              capabilities:
                add:
                  - NET_BIND_SERVICE
            volumeMounts:
              - mountPath: /usr/local/etc/haproxy
                name: cfg
                readOnly: true
        hostNetwork: true
        restartPolicy: Always
        volumes:
          - hostPath:
              path: /var/etc/ipv4-proxy
              type: DirectoryOrCreate
            name: cfg
  token: op://automation/talos-robin/MACHINE_TOKEN
cluster:
  ca:
    crt: op://automation/talos-robin/CLUSTER_CA_CRT
    {% if ENV.IS_CONTROLLER %}
    key: op://automation/talos-robin/CLUSTER_CA_KEY
    {% endif %}
  clusterName: robin
  controlPlane:
    endpoint: op://automation/talos-robin/ENDPOINT
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
      service:
        disabled: false
  id: op://automation/talos-robin/CLUSTER_ID
  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - 10.244.0.0/16
      - fd10:244::/56
    serviceSubnets:
      - fd10:96::/112
  secret: op://automation/talos-robin/CLUSTER_SECRET
  token: op://automation/talos-robin/CLUSTER_TOKEN
  {% if ENV.IS_CONTROLLER %}
  aggregatorCA:
    crt: op://automation/talos-robin/CLUSTER_AGGREGATORCA_CRT
    key: op://automation/talos-robin/CLUSTER_AGGREGATORCA_KEY
  allowSchedulingOnControlPlanes: true
  apiServer:
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
    certSANs: [ op://automation/talos-robin/CERT_SANS ]
    disablePodSecurityPolicy: true
    extraArgs:
      enable-aggregator-routing: "true"
      feature-gates: ImageVolume=true,MutatingAdmissionPolicy=true,ResourceHealthStatus=true
      runtime-config: admissionregistration.k8s.io/v1beta1=true
    image: registry.k8s.io/kube-apiserver:v1.36.1
  controllerManager:
    extraArgs:
      bind-address: "::"
    image: registry.k8s.io/kube-controller-manager:v1.36.1
  coreDNS:
    disabled: true
  etcd:
    ca:
      crt: op://automation/talos-robin/CLUSTER_ETCD_CA_CRT
      key: op://automation/talos-robin/CLUSTER_ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://[::]:2381
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:v1.36.1
  scheduler:
    extraArgs:
      bind-address: "::"
    image: registry.k8s.io/kube-scheduler:v1.36.1
  secretboxEncryptionSecret: op://automation/talos-robin/CLUSTER_SECRETBOXENCRYPTIONSECRET
  serviceAccount:
    key: op://automation/talos-robin/CLUSTER_SERVICEACCOUNT_KEY
  {% endif %}
