apiVersion: batch/v1
kind: Job
metadata:
  name: zfs-bootstrap
  namespace: kube-system
spec:
  template:
    spec:
      hostNetwork: true
      hostPID: true
      restartPolicy: Never
      containers:
      - name: zfs-setup
        image: alpine:latest
        securityContext:
          privileged: true
        volumeMounts:
        - name: dev
          mountPath: /dev
        command:
          - /bin/sh
          - -c
          - |
            set -e
            apk add --no-cache zfs > /dev/null

            DEVICE='{{ device_path }}'
            POOL='{{ pool_name }}'

            if zpool list "$POOL" >/dev/null 2>&1; then
              echo "Pool '$POOL' already exists."
            else
              echo "Creating ZFS pool '$POOL' on '$DEVICE'..."
              if [ ! -e "$DEVICE" ]; then
                echo "Error: Device '$DEVICE' not found."
                exit 1
              fi
              zpool create -f -m legacy -o ashift=12 -O compression=lz4 -O atime=off -O xattr=sa "$POOL" "$DEVICE"
              echo "Pool '$POOL' created successfully."
            fi
            zpool list -v
      volumes:
      - name: dev
        hostPath:
          path: /dev
