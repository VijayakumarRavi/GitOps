apiVersion: batch/v1
kind: Job
metadata:
  name: lvm-bootstrap
  namespace: kube-system
spec:
  template:
    spec:
      hostNetwork: true
      hostPID: true
      restartPolicy: Never
      containers:
      - name: lvm-setup
        image: alpine:latest
        securityContext:
          privileged: true
        volumeMounts:
        - name: dev
          mountPath: /dev
        command:
          - /bin/sh
          - -c
          - |
            set -e
            apk add --no-cache lvm2 > /dev/null

            DEVICE='{{ device_path }}'
            VG='{{ vg_name }}'
            THINPOOL="${VG}_thinpool"

            # VG Creation
            if vgs "$VG" >/dev/null 2>&1; then
              echo "Volume Group '$VG' already exists."
            else
              echo "Creating LVM PV and VG '$VG' on '$DEVICE'..."
              if [ ! -e "$DEVICE" ]; then
                echo "Error: Device '$DEVICE' not found."
                exit 1
              fi
              pvcreate -y "$DEVICE"
              vgcreate -y "$VG" "$DEVICE"
              echo "VG '$VG' created successfully."
            fi

            # Thin Pool Creation
            if lvs "$VG/$THINPOOL" >/dev/null 2>&1; then
              echo "Thin pool '$THINPOOL' already exists in VG '$VG'."
            else
              echo "Creating thin pool '$THINPOOL' taking up 98% of VG '$VG'..."
              lvcreate -l 98%VG -T "$VG/$THINPOOL"
              echo "Thin pool '$THINPOOL' created successfully."
            fi

            # Print final status
            echo "--- Current LVM Status ---"
            vgs
            lvs
      volumes:
      - name: dev
        hostPath:
          path: /dev
