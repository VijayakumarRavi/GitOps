{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Auto-merge container digest updates for trusted containers",
      "matchDatasources": [
        "docker"
      ],
      "automerge": true,
      ignoreTests: false,
      "automergeType": "pr",
      "matchUpdateTypes": [
        "digest"
      ],
      "matchPackagePatterns": [
        "ghcr.io/vijayakumarravi",
        "ghcr.io/home-operations",
        "ghcr.io/onedr0p",
        "ghcr.io/bjw-s",
        "ghcr.io/bjw-s-labs",
      ],
    },
    {
      "description": "Auto-merge GitHub Actions for minor and patch",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
    },
    {
      "description": "Auto merge KPS minors and patches",
      "matchDatasources": [
        "helm"
      ],
      "automerge": true,
      "ignoreTests": false,
      "matchPackageNames": [
        "kube-prometheus-stack"
      ],
      "automergeType": "pr"
    },
    {
      "description": "Auto merge minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Disable Auto merge for immich updates",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/*"
      ],
      "automerge": false
    },
  ]
}
