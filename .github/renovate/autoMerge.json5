{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Auto-merge container digest updates for trusted containers",
      "matchDatasources": ["docker"],
      "automerge": true,
      ignoreTests: false,
      "automergeType": "branch",
      "matchUpdateTypes": ["digest"],
      "matchPackagePatterns": ["ghcr.io/vijayakumarravi", "ghcr.io/home-operations", "ghcr.io/onedr0p", "ghcr.io/bjw-s", "ghcr.io/bjw-s-labs"],
      "minimumReleaseAge": "2 day"
    },
    {
      "description": "Auto-merge GitHub Actions for minor and patch",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-tags"],
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "2 day"
    },
    {
      "description": "Auto merge KPS minors and patches",
      "matchDatasources": ["helm"],
      "automerge": true,
      "ignoreTests": false,
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["kube-prometheus-stack"],
      "minimumReleaseAge": "2 day",
      "automergeType": "branch"
    },
    {
      "description": "Auto merge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "minimumReleaseAge": "2 day",
      "automergeType": "branch"
    },
    {
      "description": "Disable Auto merge for immich updates",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/*"],
      "minimumReleaseAge": "2 day",
      "automerge": false
    }
  ]
}
